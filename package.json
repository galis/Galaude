{
  "name": "galaude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从零手写的 agent 编排器（学习向）— think → act → observe 循环",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier -w src"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/deepseek": "^1.1.3",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "dotenv": "^16.4.7",
    "ink": "^7.1.0",
    "openai": "^4.77.0",
    "react": "^19.2.7",
    "string-width": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
