# 复制为 .env 并填入你自己的 key（.env 已被 .gitignore 忽略，不会进版本库）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：主 think 模型，负责核心推理/回答/工具调用（默认 deepseek-v4-pro，1M 上下文）
# THINK_MODEL=deepseek-v4-pro

# 可选：内部辅助任务（风险判断/摘要/折叠）用的轻量模型（默认 deepseek-v4-flash）
# FLASH_MODEL=deepseek-v4-flash

# 可选：引擎切换（默认 langgraph；handwritten = 手写循环对照基线，
# 同一个 UI/会话存档，可交替使用，见 docs/langgraph-vs-handwritten.md）
# ENGINE=handwritten

# 可选：LangSmith 全链路追踪（仅 langgraph 引擎生效；⚠️ 完整 prompt 会上传云端，
# 内网/合规敏感环境先确认，或自建 LangSmith / 换 Langfuse）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxxxxxxx

# 可选：单次输入内 think→act 最大轮数（默认 100，防死循环）
# MAX_TURNS=100

# 可选：run_bash 单条命令超时毫秒数（默认 60000；构建/测试类命令别设太短）
# BASH_TIMEOUT_MS=60000

# 可选：确认门模式（默认 auto=规则+模型判风险才确认；strict=危险工具一律确认）
# APPROVAL_MODE=strict

# 可选：上下文 token 预算，必须 ≤ 模型真实窗口（默认 1048576=1M，对应 deepseek-v4-pro；
# 换更小窗口的模型时记得调小，否则压缩来不及触发、API 先溢出）
# CTX_BUDGET=1048576

# —— 上下文压缩参数（所有 CTX_* 见 docs/context-compression.md）——
# 投影 > budget*trimFrac 时开始裁旧工具输出（层 A，默认 0.3）
# CTX_TRIM_FRAC=0.3
# 投影 > budget*summarizeFrac 时折叠旧轮成摘要（层 B，默认 0.5）
# CTX_SUM_FRAC=0.5
# 最近几条 role:tool 输出留全（默认 4）
# CTX_KEEP_TOOLS=4
# 最近几轮原文不折叠（默认 3）
# CTX_KEEP_TURNS=3
# content 超过多少字符才值得裁（默认 300）
# CTX_TRIM_MIN=300
# 摘要本身 token 占比超此 → 二级折叠（层 B 触顶，默认 0.25）
# CTX_FOLD_FRAC=0.25
# 每次把几段旧摘要再折一层（默认 4）
# CTX_FOLD_GROUP=4
# ctx 超此 / 出现高层摘要 → 软提示（默认 0.85）
# CTX_WARN_FRAC=0.85

# 可选：关闭常规调试日志
# DEBUG=0

# 可选：重型协议研究日志——每轮完整投影 messages JSON + 每个 delta chunk 原始内容
# 全记进日志（日志会非常大，只在研究 SSE 协议时开）
# TRACE_STREAM=1
